{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "web-ml-app",
  "compatibility_date": "2026-10-06",

  // Don't expose an alternative production URL.
  "workers_dev": false,

  // Don't expose public preview URLs.
  "preview_urls": false,

  "routes": [
    {
      "pattern": "app.example.com",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}