{
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "samata-ml",
	"compatibility_date": "2026-10-06",

	// Don't expose an alternative production URL.
	"workers_dev": false,

	// Expose Version URLs on workers.dev for release previews.
	"preview_urls": true,

	"routes": [
		{
			"pattern": "beta.samata.ml",
			"custom_domain": true
		}
	],

	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
