{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(bun)",
			"Bash(bun *)",
			"Bash(bunx)",
			"Bash(bunx *)",
			"Bash(git status*)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git branch*)",
			"Bash(git rev-parse*)",
			"Bash(git show*)",
			"Bash(ls)",
			"Bash(ls *)",
			"Bash(cat *)",
			"Bash(grep *)",
			"Bash(rg *)",
			"Bash(find *)",
			"Bash(wc *)",
			"Bash(head *)",
			"Bash(tail *)",
			"Bash(sed -n *)",
			"Bash(file *)",
			"Bash(date)",
			"Bash(date *)",
			"Bash(python3 .agents/*)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git worktree list*)",
			"Bash(git cherry*)",
			"Bash(git merge-base*)"
		],
		"deny": [
			"Bash(git add -A*)",
			"Bash(git add --all*)",
			"Bash(git add -u*)",
			"Bash(git add --update*)",
			"Bash(git add .)",
			"Bash(git add . *)",
			"Bash(git commit -a*)",
			"Bash(git commit --all*)",
			"Bash(git commit --amend*)",
			"Bash(git push*)"
		]
	}
}
