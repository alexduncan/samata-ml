{
	"name": "samata-ml",
	"version": "0.1.0-beta.1",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "bun run scripts/build.ts",
		"content:check": "bun run scripts/check-content.ts",
		"version:release": "bun run scripts/release.ts",
		"deploy": "bun run build && wrangler deploy",
		"deploy:dry-run": "bun run build && wrangler deploy --dry-run",
		"server": "bun run scripts/server.ts",
		"mockups": "bun run scripts/serve-mockups.ts",
		"audit:mockups": "bun run scripts/audit-mockups.ts",
		"test": "bun test",
		"test:e2e": "playwright test",
		"test:e2e:blocking": "SAMATA_E2E_TIER=blocking playwright test",
		"test:e2e:advisory": "playwright test tests/visual-parity.e2e.ts tests/a11y.e2e.ts --project=chromium",
		"storybook:manifest": "custom-elements-manifest analyze",
		"storybook": "bun run storybook:manifest && storybook dev --port 6006 --ci",
		"storybook:build": "bun run storybook:manifest && storybook build --output-dir storybook-static",
		"test:stories": "bun run storybook:manifest && vitest run --project storybook",
		"typecheck": "tsc --noEmit",
		"lint": "bun run scripts/lint-tsdoc.ts",
		"check": "bun run typecheck && bun test",
		"format": "python3 \"$HOME/.agents/skills/implement/scripts/format_repo.py\" --write",
		"format:check": "python3 \"$HOME/.agents/skills/implement/scripts/format_repo.py\" --check",
		"plans:check": "python3 \"$HOME/.agents/skills/create-plan/scripts/validate_plan.py\"",
		"plans:task": "python3 \"$HOME/.agents/skills/implement/scripts/task_gate.py\"",
		"plans:review": "python3 \"$HOME/.agents/skills/verify-plan/scripts/review_gate.py\"",
		"plans:close": "python3 \"$HOME/.agents/skills/verify-implementation/scripts/close_plan.py\"",
		"plans:baseline": "python3 \"$HOME/.agents/skills/implement/scripts/check_baseline.py\"",
		"git:sync": "python3 \"$HOME/.agents/skills/implement/scripts/git_land.py\" sync",
		"git:land": "python3 \"$HOME/.agents/skills/implement/scripts/git_land.py\" land",
		"git:status": "python3 \"$HOME/.agents/skills/implement/scripts/git_land.py\" status",
		"git:release": "python3 \"$HOME/.agents/skills/implement/scripts/git_land.py\" release",
		"git:tidy": "python3 \"$HOME/.agents/skills/implement/scripts/git_land.py\" tidy",
		"now": "date -u +%Y-%m-%dT%H:%M:%SZ"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@custom-elements-manifest/analyzer": "^0.10.4",
		"@federicocarboni/saxe": "0.8.0",
		"@microsoft/tsdoc": "0.17.1",
		"@microsoft/tsdoc-config": "0.18.3",
		"@playwright/test": "^1.50.0",
		"@storybook/addon-a11y": "10.6.7",
		"@storybook/addon-docs": "10.6.7",
		"@storybook/addon-vitest": "10.6.7",
		"@storybook/web-components": "10.6.7",
		"@storybook/web-components-vite": "10.6.7",
		"@types/bun": "latest",
		"@types/marked": "^6.0.0",
		"@types/papaparse": "^5.5.2",
		"@vitest/browser": "5.1.0",
		"@vitest/browser-playwright": "5.1.0",
		"fake-indexeddb": "6.2.6",
		"fflate": "0.8.2",
		"gray-matter": "^4.0.3",
		"happy-dom": "^17.1.6",
		"marked": "^18.1.1",
		"oxc-parser": "0.159.0",
		"playwright": "1.65.0",
		"prettier": "3.8.3",
		"prettier-plugin-css-order": "^2.2.0",
		"storybook": "10.6.7",
		"svgo": "4.1.0",
		"typescript": "^7.0.2",
		"vite": "7.3.8",
		"vitest": "5.1.0",
		"wrangler": "4.166.0"
	},
	"dependencies": {
		"@nanostores/i18n": "^0.10.0",
		"@nanostores/lit": "^0.2.3",
		"@observablehq/plot": "0.6.18",
		"idb": "^8.0.4",
		"lit": "^3.3.3",
		"nanostores": "^0.11.4",
		"papaparse": "^5.7.0",
		"web-ml": "./vendor/web-ml/web-ml-0.2.0.tgz"
	},
	"customElements": "custom-elements.json"
}
